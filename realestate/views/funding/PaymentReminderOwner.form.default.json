{
    "name": "Payment Reminder Owner",
    "description": "Display the owner-specific record created for a payment reminder.",
    "routes": [
        {
            "id": "route.preview_reminder",
            "type": "entry",
            "label": "Preview Reminder",
            "icon": "preview",
            "description": "",
            "route": "/?get=realestate_funding_fiscalperiod_paymentreminder_single-pdf&payment_reminder_id=object.payment_reminder_id&ownership_id=object.ownership_id",
            "target": "_blank",
            "absolute": true
        }
    ],
    "actions": [
        {
            "id": "action.ignore",
            "label": "Ignore",
            "description": "Ignore Payment Reminder (do not send).",
            "controller": "core_model_transition",
            "params": {
                "entity": "realestate\\funding\\PaymentReminderOwner",
                "transition": "ignore"
            },
            "visible": ["status", "in", ["draft", "pending"]]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "33%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "condo_id",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "payment_reminder_id",
                                                "width": "100%",
                                                "visible": false
                                            }
                                        ]
                                    },
                                    {
                                        "width": "33%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "ownership_id",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "33%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "due_amount",
                                                "width": "100%",
                                                "widget": {
                                                    "readonly": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "due_balance",
                                                "width": "100%",
                                                "widget": {
                                                    "readonly": true
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "payment_reminder_owner_lines_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
