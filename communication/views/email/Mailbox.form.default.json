{
    "name": "Mailbox",
    "actions": [
        {
            "id": "action.fetch_emails",
            "inline": true,
            "label": "Receive",
            "icon": "sync",
            "description": "Fetch latest emails and import attachments.",
            "controller": "communication_email_Mailbox_fetch",
            "params": {
                "id": "object.id"
            },
            "visible": [
                ["can_receive", "=", true],
                ["validated", "=", "object.status"]
            ]
        },
        {
            "id": "action.flush_emails",
            "inline": true,
            "label": "Send",
            "icon": "sync",
            "description": "Send pending outgoing emails.",
            "controller": "communication_email_Mailbox_flush",
            "params": {
                "id": "object.id"
            },
            "visible": [
                ["can_send", "=", true],
                ["validated", "=", "object.status"]
            ]
        }
    ],
    "routes": [
        {
            "id": "item.config",
            "label": "Settings",
            "description": "",
            "icon": "settings",
            "visible": ["admins", "in", "user.groups"],
            "context": {
                "entity": "communication\\email\\Mailbox",
                "view": "form.config",
                "domain": ["id", "=", "object.id"]
            }
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "id": "section.incoming",
                        "label": "Inbox",
                        "visible": ["can_receive", "=", true],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "incoming_emails_ids",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "can_send",
                                                "width": "0%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "can_receive",
                                                "width": "0%",
                                                "visible": false
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.outgoing",
                        "label": "Outbox",
                        "visible": ["can_send", "=", true],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "outgoing_emails_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}