{
    "name": "Owner dashboard",
    "description": "",
    "layout": {
        "groups": [
			{
                "id": "group.main",
                "label": "test",
                "height": "100%",
                "sections": [
                    {
                        "rows": [
                            {
                                "height": "50%",
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "id": "item.fundings",
                                                "label": "Payments",
                                                "description": "",
                                                "width": "50%",
                                                "entity": "realestate\\sale\\pay\\Funding",
                                                "view": "list.dashboard",
                                                "domain": [
                                                    ["ownership_id", "in", "user.ownerships_ids"],
                                                    ["status", "<>", "pending"],
                                                    ["funding_type", "in", ["fund_request", "expense_statement", "reminder"]]
                                                ]
                                            },
                                            {
                                                "id": "item.property_lots",
                                                "label": "Property Lots",
                                                "description": "",
                                                "width": "50%",
                                                "entity": "realestate\\property\\PropertyLot",
                                                "view": "list.dashboard",
                                                "domain": ["active_ownership_id", "in", "user.ownerships_ids"]
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "height": "50%",
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "id": "item.general_assemblies",
                                                "label": "Assemblies",
                                                "description": "",
                                                "width": "50%",
                                                "entity": "realestate\\governance\\Assembly",
                                                "view": "list.dashboard",
                                                "domain": ["condo_id", "in", "user.condos_ids"]
                                            },
                                            {
                                                "id": "item.documents",
                                                "label": "Documents",
                                                "description": "",
                                                "width": "50%",
                                                "entity": "documents\\Document",
                                                "view": "list.dashboard",
                                                "domain": [
                                                    ["condo_id", "in", "user.condos_ids"],
                                                    ["assembly_id", "is", null],
                                                    ["supplier_id", "is", null],
                                                    ["ownership_id", "is", null],
                                                    ["owner_id", "is", null],
                                                    ["document_visibility", "in", ["condo", "ownership", "owner"]],
                                                    ["document_type_code", "in", ["ownership_identification_document", "condominium_council_document", "condominium_council_minutes"]]
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
