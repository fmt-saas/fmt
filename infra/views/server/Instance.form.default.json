{
    "name": "Model",
    "description": "Instance manages service or product instances, detailing type, version, URL, access information, and running software.",
    "actions": [
        {
            "id": "action.create_user_token",
            "label": "Create user's access token",
            "icon": "",
            "description": "Create an access token for the instance's user.",
            "controller": "infra_server_Instance_token",
            "params": {
                "save_in_description": true
            },
            "visible": ["user_token_generated", "=", false]
        },
        {
            "id": "action.start",
            "label": "Start instance",
            "icon": "",
            "description": "Start instance using b2 api.",
            "controller": "infra_server_Instance_start",
            "visible": ["up", "=", false]
        },
        {
            "id": "action.stop",
            "label": "Stop instance",
            "icon": "",
            "description": "Stop instance using b2 api.",
            "controller": "infra_server_Instance_stop",
            "visible": ["up", "=", true]
        },
        {
            "id": "action.delete",
            "label": "Remove instance",
            "icon": "",
            "description": "Remove instance and b2 instance if server configured with b2 API access.",
            "controller": "infra_server_Instance_delete",
            "visible": ["up", "=", false]
        },
        {
            "id": "action.create_dns_record",
            "label": "Create DNS record",
            "icon": "",
            "description": "Create a DNS record for the instance.",
            "controller": "infra_server_Instance_create-dns-record",
            "params": {
                "id": "object.id"
            },
            "visible": ["has_dns_record", "=", false]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "id": "section.infos",
                        "label": "Infos",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "instance_type",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "up",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "synced",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "url",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "access_token",
                                                "width": "100%",
                                                "widget": {
                                                    "type": "string"
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_dns_record",
                                                "width": "0%",
                                                "visible": false
                                            }
                                        ]
                                    },
                                    {
                                        "width": "25%",
                                        "items": []
                                    },
                                    {
                                        "width": "25%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "server_id",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "uuid",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "user_id",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.statuses",
                        "label": "Statuses",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "refreshed",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_config_file_ok",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "branch_equal",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "branch_fmt",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_required_data_ok",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_branch_equal_ok",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_branch_fmt_ok",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_tasks_ok",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_branch_equal_up_to_date",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_branch_fmt_up_to_date",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "statuses_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.instance",
                                                    "limit": 5
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
