                                        "items": [
                                            {"type": "field", "value": "status", "width": "50%", "visible": false},
                                            {"type": "field", "value": "transfer_date", "width": "50%"},
                                            {"type": "field", "value": "accounting_date", "width": "50%"},
                                            {"type": "field", "value": "snapshot_at", "width": "50%"}
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.calculation",
                        "label": "Calculation summary",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "seller_net_amount", "width": "50%"},
                                            {"type": "field", "value": "buyer_net_amount", "width": "50%"},
                                            {"type": "field", "value": "has_accounted_sources", "width": "50%"}
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "calculation_version", "width": "50%"},
                                            {"type": "field", "value": "validated_at", "width": "50%"},
                                            {"type": "field", "value": "closed_at", "width": "50%"},
                                            {"type": "field", "value": "alert_summary", "width": "100%"}
