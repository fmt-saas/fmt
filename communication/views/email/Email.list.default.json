{
    "name": "Emails",
    "description": "List of received emails.",
    "sort": "desc",
    "order": "date",
    "header": {
        "actions": {
            "ACTION.CREATE": false
        },
        "selection": {
            "default": false
        }
    },
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "8%",
                "visible": false
            },
            {
                "type": "field",
                "value": "direction",
                "width": "15%",
                "visible": false
            },
            {
                "type": "field",
                "value": "date",
                "width": "20%",
                "sortable": true,
                "widget": {
                    "usage": "date/plain"
                }
            },
            {
                "type": "field",
                "value": "thread_hash",
                "width": "20%",
                "visible": false
            },
            {
                "type": "field",
                "value": "to",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "from",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "subject",
                "width": "33%"
            },
            {
                "type": "field",
                "value": "mailbox_id",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "attachment_import_status",
                "width": "15%",
                "readonly": true,
                "widget": {
                    "styles": [
                        {
                            "apply": {
                                "text_weight": "500",
                                "text_align": "center",
                                "text_padding": "4px",
                                "border_radius": "5px"
                            }
                        },
                        {
                            "visible": ["complete", "=", "object.attachment_import_status"],
                            "apply": {
                                "background_color": "#dcfce7"
                            }
                        },
                        {
                            "visible": ["unsupported", "=", "object.attachment_import_status"],
                            "apply": {
                                "background_color": "#f5e4b5"
                            }
                        },
                        {
                            "visible": ["missing", "=", "object.attachment_import_status"],
                            "apply": {
                                "background_color": "#f5b5b5"
                            }
                        }
                    ]
                }
            },
            {
                "type": "field",
                "value": "status",
                "width": "15%"
            }
        ]
    }
}
