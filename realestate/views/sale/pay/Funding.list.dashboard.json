{
    "name": "Fundings",
    "description": "This view is intended for displaying the list of fundings.",
    "header": {
        "layout": "inline",
        "actions": false,
        "exports": false,
        "advanced_search": false
    },
    "order": "is_paid,due_date",
    "sort": "asc,desc",
    "domain": ["remaining_amount", "<>", 0],
    "on_empty": {
        "message": "Pas de paiement en attente. Tout est en ordre."
    },
    "routes": [
        {
            "id": "route.funding",
            "label": "Funding",
            "inline": true,
            "description": "",
            "icon": "visibility",
            "context": {
                "entity": "realestate\\sale\\pay\\Funding",
                "view": "form.dashboard",
                "domain": [
                    ["id", "=", "object.id"]
                ]
            }
        }
    ],
    "layout": {
        "interactions": {
            "click": false
        },
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "10%",
                "visible": false
            },
            {
                "type": "field",
                "value": "condo_id",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "due_date",
                "width": "25%"
            },
            {
                "type": "field",
                "label": "Type",
                "value": "funding_type",
                "width": "20%"
            },
            {
                "type": "field",
                "label": "Type",
                "value": "is_paid",
                "width": "10%"
            },
            {
                "type": "field",
                "label": "Remaining",
                "value": "remaining_amount",
                "width": "15%"
            }
        ]
    }
}