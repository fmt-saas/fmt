{
    "name": "Bank Statements",
    "description": "This view is intended for displaying the list of bank statements.",
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "10%",
                "visible": false
            },
            {
                "type": "field",
                "value": "condo_id",
                "width": "30%",
                "visible": false
            },
            {
                "type": "field",
                "value": "expected_opening_balance",
                "width": "30%",
                "visible": false
            },
            {
                "type": "field",
                "value": "name",
                "width": "30%"
            },
            {
                "type": "field",
                "value": "date",
                "width": "15%"
            },
            {
                "type": "field",
                "label": "Sequence",
                "value": "statement_number",
                "width": "15%"
            },
            {
                "type": "field",
                "value": "opening_balance",
                "width": "10%",
                "widget": {
                    "styles": [
                        {
                            "visible": ["opening_balance", "=", "object.expected_opening_balance"],
                            "apply": {
                                "border_radius": "5px",
                                "text_color": "#27b727"
                            }
                        },
                        {
                            "visible": ["opening_balance", "<>", "object.expected_opening_balance"],
                            "apply": {
                                "border_radius": "5px",
                                "text_color": "#ff4500"
                            }
                        }
                    ]
                }
            },
            {
                "type": "field",
                "value": "opening_date",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "closing_balance",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "closing_date",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "bank_account_iban",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "status",
                "width": "10%"
            }
        ]
    }
}