{
    "name": "Email",
    "description": "Compose or review an email message with its metadata.",
    "actions": [
        {
            "id": "action.force_attachment_import_complete",
            "label": "Mark attachment import as complete",
            "icon": "check_circle",
            "description": "Mark ignored attachments as manually reviewed.",
            "controller": "core_model_do",
            "params": {
                "entity": "communication\\email\\Email",
                "action": "force_attachment_import_complete",
                "ids": []
            },
            "confirm": true,
            "visible": [
                ["direction", "=", "incoming"],
                ["attachment_import_status", "=", "unsupported"]
            ]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "date",
                                                "width": "25%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "subject",
                                                "width": "75%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "direction",
                                                "width": "100%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "thread_hash",
                                                "width": "100%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "to",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "from",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "reply_to",
                                                "width": "100%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "cc",
                                                "width": "100%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "bcc",
                                                "width": "100%",
                                                "visible": false
                                            }
                                        ]
                                    },
                                    {
                                        "width": "12%",
                                        "items": []
                                    },
                                    {
                                        "width": "33%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "condo_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "ownership_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "suppliership_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "case_file_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "object_class",
                                                "width": "100%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "object_id",
                                                "width": "100%",
                                                "visible": false
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.message",
                        "label": "Message",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "body",
                                                "width": "100%",
                                                "widget": {
                                                    "height": "425"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.attachments",
                        "label": "Attachments",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "attachment_documents_ids",
                                                "width": "100%",
                                                "visible": ["direction", "=", "outgoing"]
                                            },
                                            {
                                                "type": "field",
                                                "value": "documents_ids",
                                                "width": "100%",
                                                "readonly": true,
                                                "visible": ["direction", "=", "incoming"]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.attachments_logs",
                        "label": "Attachments Status",
                        "visible": ["direction", "=", "incoming"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "attachment_import_status",
                                                "width": "100%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "ignored_attachments_log",
                                                "width": "100%",
                                                "readonly": true,
                                                "widget": {
                                                    "height": "200"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
