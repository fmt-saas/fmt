{
    "name": "Bank Statements",
    "description": "This view is intended for displaying the list of bank statements.",
    "header": {
        "actions": {
            "ACTION.CREATE": false
        },
        "selection": {
            "default": false,
            "actions": [
                {
                    "id": "action.delete",
                    "label": "Delete",
                    "icon": "delete",
                    "visible": true,
                    "controller": "finance_bank_BankStatement_delete",
                    "confirm": true
                }
            ]
        }
    },
    "routes": [
        {
            "id": "item.import",
            "label": "Import a Bank Statement",
            "description": "",
            "icon": "receipt_long",
            "context": {
                "entity": "finance\\bank\\BankStatementImport",
                "view": "form.import",
                "purpose": "create"
            }
        },
        {
            "id": "route.bank_statement",
            "label": "Bank Statement",
            "inline": true,
            "description": "",
            "icon": "visibility",
            "context": {
                "entity": "finance\\bank\\BankStatement",
                "view": "form.default",
                "domain": ["id", "=", "object.id"]
            }
        }
    ],
    "order": "date",
    "sort": "desc",
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "10%",
                "visible": false
            },
            {
                "type": "field",
                "value": "condo_id",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "expected_opening_balance",
                "width": "30%",
                "visible": false
            },
            {
                "type": "field",
                "label": "name",
                "value": "bank_account_id",
                "width": "0%",
                "visible": false
            },
            {
                "type": "field",
                "value": "name",
                "width": "30%",
                "readonly": true
            },
            {
                "type": "field",
                "value": "date",
                "width": "15%",
                "widget": {
                    "usage": "date"
                }
            },
            {
                "type": "field",
                "label": "Sequence",
                "value": "statement_number",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "opening_balance",
                "width": "15%",
                "widget": {
                    "styles": [
                        {
                            "visible": [["status", "=", "pending"], ["opening_balance", "=", "object.expected_opening_balance"]],
                            "apply": {
                                "border_radius": "5px",
                                "text_color": "#27b727"
                            }
                        },
                        {
                            "visible": [["status", "=", "pending"], ["opening_balance", "<>", "object.expected_opening_balance"]],
                            "apply": {
                                "border_radius": "5px",
                                "text_color": "#ff4500"
                            }
                        }
                    ]
                }
            },
            {
                "type": "field",
                "value": "closing_balance",
                "width": "15%"
            },
            {
                "type": "field",
                "label": "Assigned Employee",
                "value": "assigned_employee_id",
                "width": "15%",
                "readonly": true
            },
            {
                "type": "field",
                "label": "Document",
                "value": "document_id",
                "width": "20%",
                "readonly": true
            },
            {
                "type": "field",
                "value": "created",
                "width": "10%",
                "readonly": true,
                "widget": {
                    "usage": "date"
                }
            },
            {
                "type": "field",
                "value": "alert",
                "width": "10%",
                "readonly": true
            },
            {
                "id": "item.status",
                "type": "field",
                "label": "Status",
                "value": "document_process_status",
                "width": "10%",
                "readonly": true,
                "widget": {
                    "styles": [
                        {
                            "apply": {
                                "text_weight": "500",
                                "text_align": "center",
                                "text_padding": "4px",
                                "border_radius": "5px"
                            }
                        },
                        {
                            "visible": ["integrated", "=", "object.document_process_status"],
                            "apply": {
                                "background_color": "#dcfce7"
                            }
                        },
                        {
                            "visible": [["assigned", "completed", "validated"], "contains", "object.document_process_status"],
                            "apply": {
                                "background_color": "#f5e4b5"
                            }
                        },
                        {
                            "visible": [["created", "cancelled"], "contains", "object.document_process_status"],
                            "apply": {
                                "background_color": "#f5b5b5"
                            }
                        }
                    ]
                }
            }
        ]
    }
}
