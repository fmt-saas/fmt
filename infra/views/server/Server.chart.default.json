{
    "name": "Server status",
    "access": {
        "groups": ["admins"]
    },
    "controller": "core_model_chart",
    "layout": {
        "entity": "infra\\server\\Status",
        "stacked": false,
        "group_by": "field",
        "field": "server_id",
        "range_interval": "week",
        "range_from": "date.this.week.first",
        "range_to": "date.this.week.last",
        "datasets": [
            {
                "label": "DSK",
                "operation": ["AVG", "object.dsk_use"],
                "domain": ["server_id", "<>", null]
            },
            {
                "label": "CPU",
                "operation": ["AVG", "object.cpu_use"],
                "domain": ["server_id", "<>", null]
            },
            {
                "label": "RAM",
                "operation": ["AVG", "object.ram_use"],
                "domain": ["server_id", "<>", null]
            }
        ]
    }
}
