{
    "name": "Assemblies",
    "description": "Overview of scheduled assemblies and their status.",
    "header": {
        "layout": "inline",
        "actions": false,
        "exports": false,
        "advanced_search": false
    },
    "order": "assembly_date",
    "sort": "desc",
    "domain": ["status", "not in", ["pending"]],
    "on_empty": {
        "message": "Aucune assemblée générale planifiée."
    },
    "routes": [
        {
            "id": "route.assembly",
            "label": "Assembly",
            "inline": true,
            "description": "",
            "icon": "visibility",
            "context": {
                "entity": "realestate\\governance\\Assembly",
                "view": "form.dashboard",
                "domain": [
                    ["id", "=", "object.id"]
                ]
            }
        }
    ],
    "layout": {
        "interactions": {
            "click": false
        },
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "10%",
                "visible": false
            },
            {
                "type": "field",
                "value": "condo_id",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "assembly_type",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "assembly_date",
                "width": "15%",
                "widget": {
                    "usage": "date/plain.short"
                }
            },
            {
                "type": "field",
                "value": "is_second_session",
                "width": "10%"
            }
        ]
    }
}
