{
    "name": "Bank Statement Lines",
    "description": "This view is intended for displaying the list of bank statement lines.",
    "header": {
        "layout": "inline",
        "actions": {
            "ACTION.CREATE_INLINE": [
                {
                    "view": true
                }
            ]
        },
        "selection": {
            "default": false,
            "actions": [
                {
                    "id": "ACTION.DELETE",
                    "visible": true
                }
            ]
        }
    },
    "actions": [
        {
            "id": "action.reconcile",
            "inline": true,
            "label": "Reconcile",
            "icon": "list",
            "description": "Reconcile line.",
            "visible": false,
            "visible1": ["status", "<>", "posted"],
            "visible_help": "This is not longer allowed : matching is fully automated and depends on the selected account.",
            "component": {
                "name": "matchBankStatementLine",
                "data": {
                    "condo_id": "object.condo_id",
                    "bank_statement_line_id": "object.id"
                }
            }
        },
        {
            "id": "action.add_ownership_bank_account",
            "inline": true,
            "label": "Add ownership bank account",
            "icon": "add_card",
            "description": "Add the counterparty IBAN to the targeted ownership bank accounts.",
            "controller": "core_model_do",
            "visible": [["status", "=", "pending"], ["is_owner", "=", true]],
            "params": {
                "entity": "finance\\bank\\BankStatementLine",
                "action": "add_ownership_bank_account",
                "ids": []
            },
            "confirm": true
        }
    ],
    "operations": {
        "total": {
            "amount": {
                "operation": "SUM",
                "usage": "amount/money:2"
            }
        }
    },
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "condo_id",
                "width": "10%",
                "visible": false,
                "readonly": true
            },
            {
                "type": "field",
                "value": "is_owner",
                "width": "10%",
                "visible": false,
                "readonly": true
            },
            {
                "type": "field",
                "value": "bank_statement_id",
                "width": "10%",
                "visible": false,
                "readonly": true
            },
            {
                "type": "field",
                "label": "sequence",
                "value": "sequence_number",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "date",
                "width": "15%",
                "widget": {
                    "usage": "date/short"
                }
            },
            {
                "type": "field",
                "label": "Account",
                "value": "accounting_account_id",
                "width": "25%",
                "widget": {
                    "interactions": false,
                    "controller": "finance_accounting_Account_collect"
                }
            },
            {
                "type": "field",
                "value": "account_holder",
                "width": "15%",
                "readonly": true
            },
            {
                "type": "field",
                "value": "account_iban",
                "width": "15%",
                "readonly": true
            },
            {
                "type": "field",
                "value": "accounting_account_code",
                "width": "10%",
                "visible": false,
                "readonly": true
            },
            {
                "type": "field",
                "value": "communication",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "status",
                "width": "10%",
                "readonly": true
            },
            {
                "type": "field",
                "value": "amount",
                "width": "10%"
            }
        ]
    }
}
