{
    "name": "Consumption Statement",
    "description": "Maintain a consumption statement through its strict processing workflow.",
    "header": {
        "actions": {
            "ACTION.SAVE": [
                { "id": "SAVE_AND_CONTINUE" },
                { "id": "SAVE_AND_VIEW" },
                { "id": "SAVE_AND_CLOSE" }
            ]
        }
    },
    "actions": [
        {
            "id": "action.mark_proforma",
            "label": "Mark proforma",
            "icon": "description",
            "description": "Mark the statement as proforma.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "draft"],
            "params": {"entity": "realestate\\utility\\energy\\ConsumptionStatement", "transition": "mark_proforma", "ids": []},
            "confirm": false
        },
        {
            "id": "action.send",
            "label": "Send",
            "icon": "send",
            "description": "Mark the statement as sent after checking its allocations.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "proforma"],
            "params": {"entity": "realestate\\utility\\energy\\ConsumptionStatement", "transition": "send", "ids": []},
            "confirm": false
        },
        {
            "id": "action.mark_to_encode",
            "label": "Encode lines",
            "icon": "edit_note",
            "description": "Open the statement lines for encoding.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "sent"],
            "params": {"entity": "realestate\\utility\\energy\\ConsumptionStatement", "transition": "mark_to_encode", "ids": []},
            "confirm": false
        },
        {
            "id": "action.generate_lines",
            "label": "Generate lines",
            "icon": "play_arrow",
            "description": "Generate missing statement lines from the configured property lots.",
            "controller": "core_model_do",
            "visible": ["status", "=", "to_encode"],
            "params": {"entity": "realestate\\utility\\energy\\ConsumptionStatement", "action": "generate_statement_lines", "ids": []},
            "confirm": false
        },
        {
            "id": "action.encode",
            "label": "Mark encoded",
            "icon": "check",
            "description": "Mark the statement as encoded after checking its lines and allocations.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "to_encode"],
            "params": {"entity": "realestate\\utility\\energy\\ConsumptionStatement", "transition": "encode", "ids": []},
            "confirm": false
        },
        {
            "id": "action.integrate",
            "label": "Integrate",
            "icon": "done_all",
            "description": "Integrate the statement into accounting.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "encoded"],
            "params": {"entity": "realestate\\utility\\energy\\ConsumptionStatement", "transition": "integrate", "ids": []},
            "confirm": true
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "id": "section.statement",
                        "label": "Statement",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "condo_id", "width": "50%"},
                                            {"type": "field", "value": "consumption_file_id", "width": "50%"},

                                            {"type": "field", "value": "fiscal_year_id", "width": "50%", "visible": false},
                                            {"type": "field", "value": "fiscal_period_id", "width": "50%", "visible": false},

                                            {"type": "field", "value": "date_from", "width": "50%"},
                                            {"type": "field", "value": "date_to", "width": "50%"},

                                            {"type": "field", "value": "fixed_share_heating", "width": "50%"},
                                            {"type": "field", "value": "has_deduct_advances", "width": "50%"},

                                            {"type": "field", "value": "consumption_meter_id", "width": "50%", "visible": false},
                                            {"type": "field", "value": "posting_date", "width": "50%", "visible": false}
                                        ]
                                    },
                                    {
                                        "width": "25%",
                                        "items": []
                                    },
                                    {
                                        "width": "25%",
                                        "items": [
                                            {"type": "field", "value": "statement_total", "width": "100%"},
                                            {"type": "field", "value": "document_id", "width": "100%", "widget": {"readonly": true}},
                                            {"type": "field", "value": "status", "width": "50%", "visible": false}
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.submission_lines",
                        "label": "Submission lines",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {"type": "field", "value": "consumption_statement_submission_lines_ids", "width": "100%", "widget": {"view": "list.default"}}
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.allocations",
                        "label": "Allocations",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "consumption_statement_allocation_lines_ids",
                                                "width": "100%",
                                                "widget": {"view": "list.default"}
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.calculation_lines",
                        "label": "Calculation lines",
                        "visible": ["status", "not in", ["draft", "proforma"]],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {"type": "field", "value": "consumption_statement_calculation_lines_ids", "width": "100%", "widget": {"view": "list.default"}}
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
