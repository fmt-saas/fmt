                                                "widget": {
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": [
                                                                {
                                                                    "view": "form.create",
                                                                    "description": "#todo - visibility conditions not implemented",
                                                                    "visible": true
                                                                }
                                                            ]
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
