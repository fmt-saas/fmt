{
    "name": "Broadcast message",
    "description": "Allows to prepare and send a message by email to a specific group of co-owners.",
    "actions": [
        {
            "id": "action.validate_recipients",
            "label": "Validate recipients",
            "description": "Validate recipients and go to next step.",
            "controller": "communication_broadcast_BroadcastMessage_validate-recipients",
            "visible": [
                ["step", "=", "recipients_selection"],
                ["status", "=", "draft"]
            ]
        },
        {
            "id": "action.validate_content",
            "label": "Validate content",
            "description": "Send multiple emails from broadcast.",
            "controller": "communication_broadcast_BroadcastMessage_validate-content",
            "visible": [
                ["step", "=", "content_edition"],
                ["status", "=", "draft"]
            ]
        },
        {
            "id": "action.select_recipients",
            "label": "Select recipients",
            "description": "Back to select recipients step.",
            "controller": "model_transition",
            "params": {
                "entity": "communication\\broadcast\\BroadcastMessage",
                "transition": "select_recipients",
                "ids": []
            },
            "visible": [
                ["status", "=", "ready"]
            ]
        },
        {
            "id": "action.schedule",
            "label": "Schedule",
            "description": "Schedule the broadcast for processing.",
            "controller": "communication_broadcast_BroadcastMessage_schedule",
            "params": {
                "entity": "communication\\broadcast\\BroadcastMessage",
                "id": "object.id"
            },
            "visible": [
                ["status", "=", "ready"]
            ]
        }
    ],
    "routes": [
        {
            "id": "route.add_new_attachment",
            "label": "Add new document",
            "description": "",
            "icon": "file_upload",
            "visible": [
                [
                    ["status", "=", "draft"],
                    ["step", "=", "content_edition"]
                ],
                [
                    ["status", "=", "ready"]
                ]
            ],
            "context": {
                "entity": "documents\\import\\DocumentImport",
                "view": "form.import_and_close",
                "purpose": "create",
                "mode": "edit",
                "domain": [
                    ["condo_id", "=", "object.condo_id"],
                    ["broadcast_id", "=", "object.id"]
                ]
            }
        }
    ],
    "header": {
        "actions": {
            "ACTION.SAVE": [
                { "id": "SAVE_AND_CONTINUE" },
                { "id": "SAVE_AND_VIEW" },
                { "id": "SAVE_AND_CLOSE" }
            ]
        }
    },
    "layout": {
        "groups": [
            {
                "visible": [
                    ["step", "=", "recipients_selection"],
                    ["status", "=", "draft"]
                ],
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "condo_id",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "visible": ["state", "<>", "draft"],
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Ignore preferences",
                                                "value": "ignore_communication_preferences",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "visible": ["state", "<>", "draft"],
                                        "items": [
                                            {
                                                "id": "item.select_by_ownership",
                                                "type": "label",
                                                "value": "Select by ownership",
                                                "width": "100%",
                                                "visible": ["condo_id", "<>", null]
                                            },
                                            {
                                                "type": "field",
                                                "value": "ownerships_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.broadcast",
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false,
                                                            "ACTION.SELECT": [
                                                                { "view_id": "list.broadcast-search" }
                                                            ]
                                                        }
                                                    },
                                                    "domain": [
                                                        ["condo_id", "=", "object.condo_id"]
                                                    ]
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "visible": ["state", "<>", "draft"],
                                        "items": [
                                            {
                                                "id": "item.select_by_owner",
                                                "type": "label",
                                                "value": "Select by owner",
                                                "width": "100%",
                                                "visible": ["condo_id", "<>", null]
                                            },
                                            {
                                                "type": "field",
                                                "value": "owners_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.broadcast",
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false,
                                                            "ACTION.SELECT": [
                                                                { "view_id": "list.broadcast-search" }
                                                            ]
                                                        }
                                                    },
                                                    "domain": [
                                                        ["condo_id", "=", "object.condo_id"]
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "visible": [
                    [
                        ["step", "=", "content_edition"],
                        ["status", "=", "draft"]
                    ],
                    [
                        ["status", "in", ["ready", "scheduled", "processing", "processed"]]
                    ]
                ],
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "subject",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "label",
                                                "value": "",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "reply_to",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "body",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "visible": [
                    [
                        ["status", "<>", "draft"]
                    ],
                    [
                        ["status", "=", "draft"],
                        ["step", "=", "content_edition"]
                    ]
                ],
                "sections": [
                    {
                        "id": "section.recipients",
                        "label": "Recipients",
                        "visible": [
                            ["status", "in", ["ready", "scheduled", "processing", "processed"]]
                        ],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "identities_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.broadcast",
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    },
                                                    "limit": 5
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.documents",
                        "label": "Documents",
                        "visible": [
                            [
                                ["status", "=", "draft"],
                                ["step", "=", "content_edition"]
                            ],
                            [
                                ["status", "<>", "draft"]
                            ]
                        ],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "documents_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.default",
                                                    "mode": "edit",
                                                    "header": {
                                                        "layout": "inline",
                                                        "actions": {
                                                            "ACTION.SELECT": [
                                                                {
                                                                    "view": true
                                                                }
                                                            ],
                                                            "ACTION.CREATE": false
                                                        }
                                                    },
                                                    "domain": [
                                                        ["condo_id", "=", "object.condo_id"]
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.mails",
                        "label": "Mails",
                        "visible": [
                            ["status", "=", "processed"]
                        ],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "mails_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    },
                                                    "limit": 5
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
