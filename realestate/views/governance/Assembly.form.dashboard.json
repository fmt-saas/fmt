                                                "visible": false,
                                                "widget": {
                                                    "readonly": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_second_session",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "second_session_assembly_id",
