{
    "name": "Server status",
    "access": {
        "groups": ["admins"]
    },
    "controller": "core_model_chart",
    "layout": {
        "entity": "infra\\server\\Status",
        "stacked": false,
        "group_by": "range",
        "field": "created",
        "range_interval": "week",
        "range_from": "date.this.week.first",
        "range_to": "date.this.week.last",
        "datasets": [
            {
                "label": "DSK",
                "operation": ["AVG", "object.dsk_use"]
            },
            {
                "label": "CPU",
                "operation": ["SUM", "object.cpu_use"]
            },
            {
                "label": "RAM",
                "operation": ["SUM", "object.ram_use"]
            }
        ]
    }
}
