{
    "name": "Ownership Transfer Settlement",
    "description": "Review the accounting regularization of an ownership transfer.",
    "actions": [
        {
            "id": "action.generate_lines",
            "label": "Generate lines",
            "description": "Generate settlement lines from accounted working fund balances, fund requests, and periodic expense statements.",
            "controller": "core_model_do",
            "visible": ["status", "=", "draft"],
            "params": {
                "entity": "realestate\\property\\transfer\\OwnershipTransferSettlement",
                "action": "generate_lines",
                "ids": []
            },
            "confirm": false
        },
        {
            "id": "action.generate_operations",
            "label": "Generate accounting operations",
            "description": "Generate and post one miscellaneous operation per corrected accounting source.",
            "controller": "core_model_do",
            "visible": [["status", "=", "draft"], ["lines_ids", "<>", null]],
            "params": {
                "entity": "realestate\\property\\transfer\\OwnershipTransferSettlement",
                "action": "generate_operations",
                "ids": []
            },
            "confirm": true
        }
    ],
    "layout": {
