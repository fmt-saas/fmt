{
    "name": "Apportionment",
    "description": "",
    "header": {
        "actions": {
            "ACTION.SAVE": [
                {
                    "id": "SAVE_AND_VIEW",
                    "view_id": "form.default"
                }
            ]
        }
    },
    "actions": [
        {
            "id": "action.duplicate",
            "label": "Duplicate",
            "description": "Attempts to duplicate the apportionment.",
            "controller": "core_model_do",
            "params": {
                "entity": "realestate\\property\\Apportionment",
                "action": "duplicate"
            }
        },
        {
            "id": "action.duplicate_accounts",
            "label": "Duplicate accounts",
            "icon": "content_copy",
            "description": "Duplicate the selected account hierarchies using this apportionment.",
            "controller": "core_model_do",
            "params": {
                "entity": "realestate\\property\\Apportionment",
                "action": "duplicate_accounts",
                "params": {
                    "id": "object.id",
                    "condo_id": "object.condo_id"
                },
                "ids": []
            },
            "visible": [
                ["state", "<>", "draft"],
                ["is_statutory", "=", false]
            ],
            "confirm": true
        },
        {
            "id": "action.validate",
            "label": "Validate",
            "description": "Mark the apportionment as published.",
            "controller": "core_model_transition",
            "visible": [ ["status", "=", "pending"] ],
            "params": {
                "entity": "realestate\\property\\Apportionment",
                "transition": "validate",
                "ids": []
            }
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "50%",
                                                "widget": {
                                                    "heading": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "label": "code",
                                                "value": "code",
                                                "width": "25%",
                                                "visible": ["state", "<>", "draft"]
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_statutory",
                                                "width": "25%",
                                                "visible": false
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Condominium",
                                                "value": "condo_id",
                                                "width": "50%",
                                                "widget": {
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "total_shares",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "assigned",
                                                "value": "assigned_shares",
                                                "width": "25%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.duplication_accounts",
                        "label": "Duplication accounts",
                        "visible": [
                            ["state", "<>", "draft"],
                            ["is_statutory", "=", false]
                        ],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "suffix",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "duplication_accounts_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "mode": "edit",
                                                    "header": {
                                                        "layout": "inline",
                                                        "actions": {
                                                            "ACTION.SELECT": true,
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "label": "Shares",
                        "id": "section.apportionment_shares",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "apportionment_shares_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
