{
    "name": "Payment Reminder Owner Line",
    "description": "Display a funding line included in an owner payment reminder.",
    "actions": [
        {
            "id": "action.ignore",
            "label": "Ignore",
            "description": "Ignore Payment Reminder (do not send).",
            "controller": "core_model_transition",
            "params": {
                "entity": "realestate\\funding\\PaymentReminderOwnerLine",
                "transition": "ignore"
            },
            "visible": ["status", "in", ["draft", "pending"]]
        }
    ],
    "layout": {
