                                                    "in",
                                                    [
                                                        "assembly_validation",
                                                        "agenda_processing"
                                                    ]
                                                ]
                                            },
                                            {
                                                "type": "field",
                                                "value": "invalidity_reason",
                                                "width": "100%"
