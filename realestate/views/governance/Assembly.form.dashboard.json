                                            {
                                                "type": "field",
                                                "value": "is_complete",
                                                "width": "100%",
                                                "visible": false
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.resolutions",
