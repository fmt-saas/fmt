{
    "name": "Model",
    "description": "A Server hosts one or more instances.",
    "actions": [
        {
            "id": "action.create-instance",
            "label": "Create instance",
            "description": "Create a new instance on the server using b2 API.",
            "controller": "infra_server_Server_create-instance",
            "confirm": true,
            "visible": [
                ["global", "=", "env.instance_type"],
                ["b2_api_url", "<>", null],
                ["b2_api_url", "<>", ""],
                ["b2_api_password", "<>", null],
                ["b2_api_password", "<>", ""]
            ]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "ip_address",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "up",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "synced",
                                                "width": "25%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "b2_api_url",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "b2_api_password",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.statuses",
                        "label": "Statuses",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "statuses_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.server",
                                                    "limit": 5
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.ips",
                        "label": "IPs",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "ip_protected",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "ip_public",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "ip_private",
                                                "width": "33%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.instances",
                        "label": "Instances",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "instances_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
