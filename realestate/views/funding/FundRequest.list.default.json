            },
            {
                "type": "field",
                "value": "request_date",
                "width": "10%",
                "widget": {
                    "usage": "date/plain"
                }
            },
            {
                "type": "field",
                "value": "date_from",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "date_to",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "status",
                "width": "10%"
            },
            {
                "type": "field",
